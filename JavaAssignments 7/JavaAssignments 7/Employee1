import java.util.*;

class Employee {
    Integer id;
    String name;
    String department;
    Double salary;

    Employee(Integer id, String name, String department, Double salary) {
        this.id = id;
        this.name = name;
        this.department = department;
        this.salary = salary;
    }

    public String toString() {
        return id + " " + name + " " + department + " " + salary;
    }
}

public class EmployeeProcessing {
    public static void main(String[] args) {
        List<Employee> employees = new ArrayList<>();
        employees.add(new Employee(Integer.valueOf(101), "Alice", "IT", Double.parseDouble("55000")));
        employees.add(new Employee(Integer.valueOf(102), "Bob", "HR", Double.parseDouble("45000")));
        employees.add(new Employee(Integer.valueOf(103), "Charlie", "Finance", Double.parseDouble("60000")));
        employees.add(new Employee(Integer.valueOf(104), "David", "HR", Double.parseDouble("42000")));
        employees.add(new Employee(Integer.valueOf(105), "Eva", "IT", Double.parseDouble("58000")));
        employees.add(new Employee(Integer.valueOf(106), "Frank", "Finance", Double.parseDouble("61000")));
        employees.add(new Employee(Integer.valueOf(107), "Grace", "Sales", Double.parseDouble("47000")));
        employees.add(new Employee(Integer.valueOf(108), "Hannah", "Sales", Double.parseDouble("53000")));
        employees.add(new Employee(Integer.valueOf(109), "Ian", "IT", Double.parseDouble("49000")));
        employees.add(new Employee(Integer.valueOf(110), "Jane", "HR", Double.parseDouble("40000")));

        System.out.println("Sorted by Salary:");
        employees.sort(Comparator.comparing(e -> e.salary));
        for (Employee e : employees) {
            System.out.println(e);
        }

        Iterator<Employee> iterator = employees.iterator();
        while (iterator.hasNext()) {
            if (iterator.next().department.equalsIgnoreCase("HR")) {
                iterator.remove();
            }
        }

        System.out.println("\nAfter Removing HR Department Employees:");
        for (Employee e : employees) {
            System.out.println(e);
        }
    }
}
